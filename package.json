{
  "name": "sunrays",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-cesium-csp.mjs",
    "build": "turbo build",
    "build:frontend": "turbo build --filter=@repo/frontend",
    "dev": "turbo run dev",
    "docs": "turbo run docs",
    "lint": "turbo run lint -- --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "upgrade": "npx npm-check-updates --interactive --format group --cooldown 1d --workspaces",
    "clean": "rimraf .turbo && turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "deploy": "turbo build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "engines": {
    "node": ">=22"
  },
  "resolutions": {},
  "type": "module",
  "packageManager": "npm@11.15.0",
  "workspaces": [
    "config/eslint",
    "config/typescript",
    "docs",
    "frontend",
    "ui",
    "packages/solar"
  ],
  "overrides": {
    "zod-validation-error": "^4.0.2"
  }
}
