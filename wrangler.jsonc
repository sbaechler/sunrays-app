{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunrays",
  "compatibility_date": "2026-04-09",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./frontend/build/client",
    "not_found_handling": "single-page-application"
  },
  "secrets": {
		"required": ["VITE_CESIUM_ION_TOKEN"]
	},
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
